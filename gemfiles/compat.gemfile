# frozen_string_literal: true

# Gemfile for the CI compatibility matrix (Ruby 3.1–3.4).
#
# The main Gemfile.lock is resolved on the development Ruby (3.4) and locks
# gems that do not install on older interpreters (e.g. activesupport 8.x,
# pulled in through pundit, requires Ruby >= 3.2). This file carries only
# what the test suite needs so `required_ruby_version >= 3.1` stays
# verifiable with a fresh dependency resolution per Ruby.
source 'https://rubygems.org'

gemspec path: '..'

group :development, :test do
  gem 'rspec', '~> 3.13'
end
